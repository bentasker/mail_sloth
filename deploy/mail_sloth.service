[Unit]
Description=mail_sloth mail server and API
Documentation=https://github.com/pauldix/mail_sloth
After=network-online.target
Wants=network-online.target

[Service]
User=mail_sloth
Group=mail_sloth
ExecStart=/usr/local/bin/mail_sloth serve
Environment=MAIL_SLOTH_CONFIG=/etc/mail_sloth/config.toml
Environment=RUST_LOG=info
Restart=always
RestartSec=3
# Ports 25 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/mail_sloth
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
